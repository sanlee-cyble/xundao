# Copy to .env on ECS. Do not commit real credentials.
POSTGRES_PASSWORD=change-this-strong-password

# Optional when using Alibaba Cloud RDS PostgreSQL instead of the compose db.
# DATABASE_URL=postgres://user:password@rds-host:5432/xundao
# DATABASE_SSL=false

PORT=8731
HOST=0.0.0.0
XUNDAO_DATA_DIR=/app/data
XUNDAO_RUNS_DIR=/app/runs

# Browser runtime. Use "bundled" inside the Playwright Docker image.
PGY_BROWSER_CHANNEL=bundled
PGY_LOGIN_HEADLESS=true
PGY_USER_DATA_DIR=/app/.pgy-browser-profile

# Required for Medela template recommendation reasons.
# Never commit a real key.
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Qwen is used for intent and field-resolution tool calls.
# QWEN_API_KEY_FILE may point to a credential CSV outside the repository.
QWEN_API_KEY=replace-with-qwen-key
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-max
MODEL_TIMEOUT_MS=90000

# Team accounts and retention.
AUTH_REQUIRED=true
# Local localhost instances can create the first administrator in the browser.
# Remote deployments should keep this false and use BOOTSTRAP_ADMIN_* instead.
ALLOW_FIRST_RUN_SETUP=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-on-first-login
SESSION_TTL_DAYS=14
TASK_RETENTION_DAYS=7
TASK_RETENTION_CLEANUP_ENABLED=true
ANALYTICS_RETENTION_DAYS=180
COOKIE_SECURE=true

# Per-user PGY connections. Use a secret from the deployment secret manager.
PGY_USER_DATA_ROOT=/app/pgy-profiles
PGY_CONNECTION_ENCRYPTION_KEY=replace-with-32-byte-secret
XUNDAO_DEFAULT_WORKSPACE_ID=team

# Used by scripts/ecs-bootstrap.sh to request and renew the HTTPS certificate.
LETSENCRYPT_EMAIL=ops@example.com

# Local development fallback only. Team deployments use the per-user encrypted
# connection created from Personal Center and must not upload plaintext state.
# PGY_STORAGE_STATE_PATH=/absolute/local/path/storage-state.json

# Admin analytics is protected by the account role when AUTH_REQUIRED=true.
ANALYTICS_DEFAULT_DAYS=14
