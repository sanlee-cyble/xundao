# 寻达本地工作站配置。复制为 .env.local 后按需修改。
HOST=127.0.0.1
PORT=8731
AUTH_REQUIRED=true
ALLOW_FIRST_RUN_SETUP=true
COOKIE_SECURE=false
TASK_RETENTION_DAYS=7
TASK_RETENTION_CLEANUP_ENABLED=true
PGY_BROWSER_CHANNEL=chrome

# 可选：模型能力。留空时蒲公英原始取数、公式和 Excel 主链路仍可运行。
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-max
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
